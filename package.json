{
  "name": "youtube-factory",
  "version": "1.0.0",
  "description": "Autonomous Faceless YouTube Video Factory powered by HyperFrames and Ollama",
  "type": "module",
  "scripts": {
    "video": "tsx src/cli.ts",
    "produce": "tsx src/cli.ts",
    "system:diagnose": "tsx src/system/hardware-diagnostics.ts",
    "runtime": "tsx src/system/runtime.ts",
    "setup:tts": "node scripts/bootstrap.mjs",
    "setup:tts:xpu": "node scripts/bootstrap.mjs --xpu",
    "setup:check": "node scripts/bootstrap.mjs --check",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:v22",
    "test:v22": "tsx test/test-v22-regression.ts",
    "test:v23": "tsx test/test-v23-research.ts",
    "test:v24": "tsx test/test-v24-dashboard.ts",
    "test:all": "npm run typecheck && npm run studio:web:typecheck && npm run test:v2 && npm run test:generalization && npm run test:v22 && npm run test:v23 && npm run test:v24",
    "milestone1": "tsx test/milestone1.ts",
    "milestone2": "tsx test/milestone2.ts",
    "milestone3": "tsx test/milestone3.ts",
    "milestone4": "tsx test/milestone4.ts",
    "milestone5": "tsx test/milestone5.ts",
    "milestone6": "tsx test/milestone6.ts",
    "milestone7": "tsx test/milestone7.ts",
    "milestone8": "tsx test/milestone8.ts",
    "milestones": "npm run milestone1 && npm run milestone2 && npm run milestone3 && npm run milestone4 && npm run milestone5 && npm run milestone6 && npm run milestone7 && npm run milestone8",
    "test:v2": "tsx test/test-v2-pipeline.ts",
    "test:generalization": "tsx test/test-generalization.ts",
    "topic": "tsx src/cli.ts --workspace",
    "plan": "tsx src/cli.ts --workspace --plan-only",
    "search": "tsx src/search/cli.ts",
    "studio:server": "tsx watch studio/server/index.ts",
    "studio:web": "vite --config studio/web/vite.config.ts studio/web",
    "studio:web:build": "vite build --config studio/web/vite.config.ts studio/web",
    "studio:web:typecheck": "tsc -p studio/web --noEmit",
    "studio": "npm run studio:web:build && tsx studio/server/index.ts"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "gsap": "^3.15.0",
    "hyperframes": "^0.8.34",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.13.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^8.3.0"
  }
}
