{
  "version": "3.0.0",
  "name": "Editorial Documentary",
  "canvas": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "safeZone": {
      "top": 96,
      "bottom": 96,
      "left": 128,
      "right": 128
    }
  },
  "typography": {
    "fontFamilyDisplay": "'Inter', 'Segoe UI', system-ui, sans-serif",
    "fontFamilyBody": "'Inter', 'Segoe UI', system-ui, sans-serif",
    "fontFamilyCode": "'JetBrains Mono', 'Consolas', monospace",
    "scale": {
      "hero": "76px",
      "h1": "54px",
      "h2": "44px",
      "h3": "28px",
      "body": "21px",
      "caption": "16px"
    },
    "lineHeight": 1.45,
    "weights": {
      "bold": 700,
      "semi": 600,
      "normal": 400
    }
  },
  "colors": {
    "background": "#12100e",
    "backgroundElevated": "#1a1815",
    "surface": "#201d1a",
    "surfaceBorder": "rgba(240, 235, 226, 0.14)",
    "primary": "#d98b33",
    "secondary": "#6f7d8c",
    "accent": "#b5452f",
    "success": "#5f8a5f",
    "warning": "#c98a2b",
    "text": "#f4efe7",
    "textMuted": "#a49c90",
    "textFaint": "#776e63",
    "gridLine": "rgba(240, 235, 226, 0.05)"
  },
  "motion": {
    "easeDefault": "power2.out",
    "easeEmphasis": "power3.inOut",
    "durationFast": 0.4,
    "durationMedium": 0.7,
    "durationSlow": 1.1,
    "staggerDefault": 0.12
  },
  "visualStyles": {
    "density": "medium",
    "cardBorderRadius": "2px",
    "cardGlow": "none",
    "chartTheme": {
      "gridColor": "rgba(240, 235, 226, 0.08)",
      "lineColor": "#d98b33",
      "fillColor": "rgba(217, 139, 51, 0.12)",
      "barColor": "#d98b33",
      "accentColor": "#b5452f"
    },
    "diagramTheme": {
      "nodeBackground": "#201d1a",
      "nodeBorder": "rgba(240, 235, 226, 0.14)",
      "edgeColor": "#776e63",
      "edgeActive": "#d98b33"
    }
  }
}
