# ==========================================
# Autonomous Documentary Factory — environment
# Copy to .env and adjust. Everything runs locally; no external inference services.
# ==========================================

# TTS compute device for local Chatterbox synthesis.
#   cpu  — reference path (.venv). Measured ~4.0-4.5x real-time on the i5-10400.
#   xpu  — Intel Arc via torch XPU (.venv-xpu). Measured ~3.1x real-time in the pipeline.
# Leave unset to auto-select: xpu when .venv-xpu exists, otherwise cpu.
# cuda/mps are accepted values but this machine's NVIDIA adapter is a legacy part with no
# modern CUDA runtime; the runtime preflight will refuse it with an actionable message.
# TTS_DEVICE=cpu

# Optional: a Hugging Face token raises rate limits for the one-time Chatterbox model download.
# HF_TOKEN=

# Video specs (also in config/channel.json; env is informational for tooling)
DEFAULT_FPS=30
DEFAULT_RESOLUTION=1920x1080
